// Schéma SiNote — marketplace de cours de musique/chant.
//
// Deux conventions structurantes, à lire avant de modifier quoi que ce soit :
//
// 1. Les disponibilités d'un prof sont des RÈGLES, pas des créneaux. On ne
//    matérialise jamais un slot en base : les créneaux libres se calculent à la
//    lecture (règles − exceptions − réservations). Voir AvailabilityRule.
//
// 2. Distinction heure locale / instant. Les règles de dispo sont stockées en
//    minutes depuis minuit dans le fuseau du prof (User.timezone) : « dispo le
//    lundi 9h » doit rester 9h après le changement d'heure. Les Booking, eux,
//    sont des instants absolus en timestamptz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth) — ne pas renommer les champs ni les @@map sans ajuster
// l'adaptateur dans lib/auth.ts.
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
  // Déprécié : l'administration est désormais une capacité orthogonale
  // (`User.isAdmin`), pas un rôle — un prof ou un élève peut être admin. La
  // valeur reste ici uniquement parce que retirer un membre d'un enum Postgres
  // est une chirurgie inutile : plus rien ne l'écrit ni ne la lit.
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Nom d'affichage, au format attendu par Better Auth : c'est lui qu'écrit
  // l'inscription et que lit tout le reste de l'application. Il reste donc la
  // source unique du nom complet.
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Prénom et nom saisis séparément.
  //
  // Deux champs plutôt qu'un parce que la coupure ne se devine pas : « Jean
  // Baptiste Moreau » se découpe aussi bien en Jean / Baptiste Moreau qu'en
  // Jean Baptiste / Moreau, et les avis sont signés du seul prénom. Les
  // déduire de `name` à la lecture donnait donc un prénom deviné, réécrit à
  // chaque affichage sans que personne puisse le corriger.
  //
  // Nuls tant que l'utilisateur n'a rien saisi : Better Auth ne renseigne que
  // `name`. `lib/user/name.ts` retombe alors sur le découpage, en un seul
  // endroit. Toute écriture de ces deux champs **recompose `name`** dans la
  // même requête — c'est l'invariant qui évite d'avoir deux vérités.
  firstName String?
  lastName  String?

  // null tant que l'onboarding n'est pas fait : l'inscription crée le compte
  // avant que l'utilisateur ait choisi son rôle. Les routes doivent rediriger
  // vers /onboarding tant que ce champ est nul. Ne vaut plus que STUDENT ou
  // TEACHER (voir la note sur l'enum Role) : l'admin est porté à part.
  role     Role?

  // Capacité d'administration, **orthogonale** au rôle : un prof ou un élève
  // peut être administrateur. Volontairement un booléen et non une valeur de
  // `role`, qui forçait une exclusivité fausse (un admin ne pouvait être ni
  // prof ni élève). Aucune interface ne l'écrit — promotion à la main en base
  // (`UPDATE "user" SET "isAdmin" = true WHERE email='…'`), comme avant.
  isAdmin  Boolean @default(false)
  // Fuseau IANA ("Europe/Paris"). Sert à interpréter les règles de dispo côté
  // prof, et à afficher les créneaux dans l'heure locale côté élève.
  timezone String @default("Europe/Paris")

  sessions       Session[]
  accounts       Account[]
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Catalogue d'instruments — table à part et non String[] : on filtre et on
// facette dessus dans la recherche, et les alias servent à faire matcher
// « technique vocale » ou « coaching vocal » sur « chant ».
// ---------------------------------------------------------------------------

enum InstrumentFamily {
  VOICE
  KEYBOARD
  STRINGS
  WINDS
  BRASS
  PERCUSSION
  ELECTRONIC
  THEORY
}

model Instrument {
  id      String           @id @default(cuid())
  slug    String           @unique // "chant", "guitare-classique"
  name    String
  family  InstrumentFamily
  aliases String[]         @default([])

  teachers TeacherInstrument[]
  students StudentInstrument[]
  bookings Booking[]

  @@index([family])
  @@map("instrument")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

// Tessiture — pertinent uniquement pour le chant.
enum VoiceType {
  SOPRANO
  MEZZO_SOPRANO
  ALTO
  COUNTERTENOR
  TENOR
  BARITONE
  BASS
  UNKNOWN
}

// ---------------------------------------------------------------------------
// Profil prof
// ---------------------------------------------------------------------------

enum ProfileStatus {
  DRAFT // en cours de création, invisible
  PENDING // soumis à modération
  PUBLISHED // visible dans la recherche
  SUSPENDED // retiré (modération, ou abonnement expiré)
}

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String        @unique // URL publique : /profs/[slug]
  status      ProfileStatus @default(DRAFT)
  headline    String? // accroche courte affichée dans les résultats
  bio         String?
  videoUrl    String? // vidéo de présentation
  publishedAt DateTime?

  // Âge : la date de naissance ne sert qu'à afficher l'âge sur la fiche
  // publique, et uniquement si le prof l'a explicitement choisi (showAge).
  // Rien n'est exposé par défaut — minimisation RGPD.
  birthDate DateTime? @db.Date
  showAge   Boolean   @default(false)

  // Modalités
  teachesOnline   Boolean  @default(true)
  teachesInPerson Boolean  @default(false)
  teachesAtHome   Boolean  @default(false) // se déplace chez l'élève
  city            String?
  postalCode      String?
  country         String   @default("FR")
  latitude        Float?
  longitude       Float?
  travelRadiusKm  Int?
  languages       String[] @default(["fr"])

  // Tarifs affichés. L'élève règle le prof directement, hors plateforme :
  // ces montants sont indicatifs et ne déclenchent aucun paiement.
  hourlyRateCents    Int?
  trialLessonOffered Boolean @default(false)
  trialLessonMinutes Int?

  // Règles de réservation, appliquées par le moteur de créneaux
  defaultDurationMin      Int @default(60)
  // Pas de la grille de créneaux, indépendant de la durée du cours. Avec un
  // pas égal à la durée, les créneaux sont jointifs et repartent du début de
  // chaque plage libre : après une réservation, tous les départs suivants se
  // décalent du battement. Un pas plus fin garde des heures rondes.
  slotGranularityMin      Int @default(30)
  bufferMin               Int @default(0) // battement entre deux cours
  minNoticeHours          Int @default(24) // délai mini avant le début du cours
  bookingHorizonDays      Int @default(60) // jusqu'où on peut réserver à l'avance
  cancellationWindowHours Int @default(24)

  // Abonnement Stripe — le modèle économique porte sur le prof, pas sur
  // l'élève. Une fiche n'est PUBLISHED que si l'abonnement est actif ;
  // app/api/webhooks/stripe/route.ts écrit ces champs.
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  instruments    TeacherInstrument[]
  rules          AvailabilityRule[]
  exceptions     AvailabilityException[]
  bookings       Booking[]
  reviews        Review[]
  reports        ReviewReport[]
  studentNotes   TeacherStudentNote[]
  messages       Message[]
  messageThreads MessageThreadState[]

  // Dernière consultation des comptes rendus : repère du signal in-app (pastille
  // sur « Comptes rendus »). Un commentaire d'élève postérieur est « non lu ».
  // Même patron que StudentProfile.coursSeenAt — défaut now() pour partir à jour.
  reportsSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, city])
  @@index([status, teachesOnline])
  @@map("teacher_profile")
}

model TeacherInstrument {
  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  yearsExperience Int?
  levelsTaught    SkillLevel[] @default([])

  @@id([teacherId, instrumentId])
  @@index([instrumentId])
  @@map("teacher_instrument")
}

// ---------------------------------------------------------------------------
// Profil élève
// ---------------------------------------------------------------------------

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Mineurs : beaucoup d'élèves de musique le sont. Le contact du responsable
  // légal est requis côté applicatif si birthDate implique moins de 18 ans.
  birthDate     DateTime? @db.Date
  guardianName  String?
  guardianEmail String?
  guardianPhone String?

  // Contexte musical
  goals             String? // « chanter en groupe », « préparer le conservatoire »
  musicalBackground String?
  readsSheetMusic   Boolean    @default(false)
  preferredGenres   String[]   @default([])
  voiceType         VoiceType? // chant uniquement

  // Préférences de cours
  prefersOnline Boolean @default(true)
  city          String?
  postalCode    String?

  instruments    StudentInstrument[]
  bookings       Booking[]
  reviews        Review[]
  teacherNotes   TeacherStudentNote[]
  messages       Message[]
  messageThreads MessageThreadState[]

  // Dernière consultation de « Mes cours » : repère du signal in-app (pastille
  // sur la nav). Un cours dont la décision du prof — confirmation, refus,
  // annulation — est postérieure est « nouveau » pour l'élève. Avancée à chaque
  // visite de la page. Défaut = now() : à la création comme à la migration, un
  // profil part « à jour », rien n'est signalé tant que rien ne change après.
  coursSeenAt DateTime @default(now())

  // Dernière consultation des comptes rendus (pastille sur « Mes dossiers »). Un
  // commentaire du prof postérieur est « non lu ». Cf. reportsSeenAt côté prof.
  reportsSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profile")
}

// ---------------------------------------------------------------------------
// Fiche élève — note privée du prof sur un élève.
//
// Persistante et propre au couple prof↔élève (une par couple), indépendante
// d'un cours précis : c'est le fil « fiche client » du prof. Jamais visible de
// l'élève. Le prof n'y accède que s'il a au moins un cours avec cet élève.
// ---------------------------------------------------------------------------

model TeacherStudentNote {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  content String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, studentId])
  @@map("teacher_student_note")
}

// ---------------------------------------------------------------------------
// Échanges asynchrones prof↔élève.
//
// Un seul modèle pour deux usages : `reportId` renseigné = commentaire sous un
// compte rendu ; `reportId` nul = fil général du couple prof↔élève. Pas de
// temps réel — la page se charge à l'ouverture. Tout est persistant, daté et
// attribué, donc modérable (la visibilité du responsable d'un mineur et le
// signalement restent à ajouter).
// ---------------------------------------------------------------------------

enum MessageSender {
  TEACHER
  STUDENT
}

model Message {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sender  MessageSender // qui a écrit — jamais déduit du contenu
  content String

  // Rattache le message à un compte rendu (commentaire contextuel). Nul pour le
  // fil général du couple.
  reportId String?
  report   LessonReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Un message peut porter une pièce jointe (image, partition, note audio) au
  // lieu ou en plus du texte : `content` peut alors être vide.
  attachments MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([teacherId, studentId, createdAt])
  @@index([reportId])
  @@map("message")
}

// ---------------------------------------------------------------------------
// État de lecture du fil général (reportId nul) d'un couple prof↔élève.
//
// Une ligne par couple, deux repères — un par participant. Un message est « non
// lu » pour un participant s'il a été écrit par l'autre après son propre
// `*ReadAt`. Nul = jamais ouvert, donc tout est non lu. Avancé quand l'onglet
// Messages du couple est consulté. Dérivé, jamais dénormalisé en compteur : la
// pastille et l'inbox recomputent à la lecture (cf. lib/messages/inbox.ts).
// ---------------------------------------------------------------------------

model MessageThreadState {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherReadAt DateTime?
  studentReadAt DateTime?

  @@unique([teacherId, studentId])
  @@map("message_thread_state")
}

// Le niveau est porté par le couple élève/instrument : un élève peut être
// avancé au piano et débutant au chant.
model StudentInstrument {
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  level          SkillLevel @default(BEGINNER)
  yearsPracticed Int?
  ownsInstrument Boolean    @default(false)

  @@id([studentId, instrumentId])
  @@index([instrumentId])
  @@map("student_instrument")
}

// ---------------------------------------------------------------------------
// Disponibilités
// ---------------------------------------------------------------------------

// Règle hebdomadaire récurrente. startMinute/endMinute sont des minutes depuis
// minuit (0-1440) dans le fuseau du prof, PAS en UTC : c'est ce qui rend la
// règle stable au passage à l'heure d'été.
model AvailabilityRule {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  weekday     Int // ISO-8601 : 1 = lundi … 7 = dimanche
  startMinute Int
  endMinute   Int

  validFrom  DateTime? @db.Date
  validUntil DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, weekday])
  @@map("availability_rule")
}

enum ExceptionType {
  BLOCKED // congés, indisponibilité ponctuelle
  EXTRA // dispo exceptionnelle hors règles hebdo
}

// Exception sur une date précise. start/endMinute nuls avec type BLOCKED =
// journée entière bloquée.
model AvailabilityException {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  date        DateTime      @db.Date
  type        ExceptionType
  startMinute Int?
  endMinute   Int?
  reason      String?

  createdAt DateTime @default(now())

  @@index([teacherId, date])
  @@map("availability_exception")
}

// ---------------------------------------------------------------------------
// Réservations
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING // demande envoyée, le prof doit valider
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  DECLINED // refusée par le prof
}

enum LessonMode {
  ONLINE
  TEACHER_PLACE
  STUDENT_PLACE
}

// startsAt/endsAt sont en timestamptz : indispensable pour la contrainte
// d'exclusion anti-chevauchement posée dans la migration (tstzrange).
model Booking {
  id String @id @default(cuid())

  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument     @relation(fields: [instrumentId], references: [id])

  startsAt DateTime      @db.Timestamptz(3)
  endsAt   DateTime      @db.Timestamptz(3)
  status   BookingStatus @default(PENDING)
  mode     LessonMode    @default(ONLINE)
  isTrial  Boolean       @default(false)

  // Montant convenu, réglé directement au prof. Conservé pour l'historique et
  // les statistiques du prof — aucun encaissement en ligne.
  priceCents Int?

  // Suivi du règlement hors plateforme. L'élève paie le prof en direct : ce
  // champ note *quand* le prof a marqué le cours comme réglé, rien de plus —
  // jamais une transaction, aucun débit. Nul = pas encore encaissé. C'est ce
  // qui distingue « cours donné » de « argent reçu » dans le pilotage
  // d'activité (encaissé vs reste à encaisser).
  paidAt DateTime?

  studentMessage String? // message joint à la demande
  teacherNote    String? // note privée du prof
  meetingUrl     String? // visio
  address        String? // présentiel

  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String? // User.id de celui qui annule
  cancellationReason String?
  completedAt        DateTime?

  review    Review?
  report    LessonReport?
  reminders BookingReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, startsAt])
  @@index([studentId, startsAt])
  @@index([status, startsAt])
  @@map("booking")
}

// ---------------------------------------------------------------------------
// Comptes rendus de cours — écrits par le prof, lus par l'élève.
//
// Rattaché à un Booking (unique, comme Review) : un compte rendu n'existe que
// pour un vrai cours. Le texte est optionnel — un compte rendu peut n'être que
// des pièces jointes (partition annotée, note audio) ou l'inverse.
// ---------------------------------------------------------------------------

model LessonReport {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  title   String? // titre libre donné par le prof ; à défaut, titre auto « Cours de … »
  content String? // le texte du compte rendu

  attachments ReportAttachment[]
  comments    Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lesson_report")
}

enum AttachmentKind {
  IMAGE
  SCORE // partition (PDF)
  AUDIO // note audio
}

// Pièce jointe d'un compte rendu. Le fichier vit dans le bucket privé
// (sinote-private) : jamais public, servi par URL signée à expiration après
// vérification que le demandeur est bien participant au cours.
model ReportAttachment {
  id       String       @id @default(cuid())
  reportId String
  report   LessonReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  storageKey  String // clé de l'objet dans le bucket privé
  filename    String // nom d'origine, pour l'affichage et le téléchargement
  contentType String
  sizeBytes   Int
  kind        AttachmentKind

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_attachment")
}

// Pièce jointe d'un message (fil général ou commentaire de compte rendu). Même
// stockage que les pièces d'un compte rendu : bucket privé, servi par URL signée
// après vérification que le demandeur est le prof ou l'élève du fil.
model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  storageKey  String // clé de l'objet dans le bucket privé
  filename    String // nom d'origine, pour l'affichage et le téléchargement
  contentType String
  sizeBytes   Int
  kind        AttachmentKind

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachment")
}

// ---------------------------------------------------------------------------
// Avis — rattachés à un cours effectivement réalisé, pour éviter le spam.
// ---------------------------------------------------------------------------

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  rating      Int // 1 à 5, contrainte CHECK en base
  comment     String?
  teacherRepl String? // droit de réponse du prof
  publishedAt DateTime? // null = en attente de modération

  report ReviewReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un seul avis par couple prof↔élève : l'avis est global (« l'élève note le
  // prof »), pas un par cours. `bookingId` reste unique et sert d'ancre vers un
  // cours réellement suivi — la garantie anti-faux avis — ainsi que d'instrument
  // et de date crédibles à l'affichage.
  @@unique([teacherId, studentId])
  @@index([teacherId, publishedAt])
  @@map("review")
}

// ---------------------------------------------------------------------------
// Signalement d'un avis par le prof qui le reçoit.
//
// Le prof ne peut ni modifier ni supprimer un avis (voir Review) : le signaler
// est son seul recours quand il est injurieux ou mensonger. Le signalement ne
// masque rien de lui-même — il remonte l'avis en tête de la file de modération,
// où un administrateur tranche. Le noté ne s'auto-arbitre jamais.
//
// `reviewId` unique : un avis n'a qu'un seul prof destinataire, donc un seul
// signalement possible. L'unicité en base arbitre deux clics simultanés là où
// un test applicatif aurait une fenêtre de course, comme partout ailleurs.
// ---------------------------------------------------------------------------

enum ReportReason {
  OFFENSIVE // propos injurieux, haineux ou diffamatoires
  DISHONEST // avis mensonger, sans rapport avec un cours réel
  PRIVACY // divulgue des informations personnelles
  SPAM // hors sujet, publicitaire
  OTHER
}

model ReviewReport {
  id       String @id @default(cuid())
  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // Le prof destinataire de l'avis, seul habilité à signaler. Stocké pour la
  // traçabilité même s'il est dérivable de l'avis.
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  reason ReportReason
  detail String? // précision facultative du prof

  resolvedAt DateTime? // null = signalement ouvert ; daté = traité par la modération
  createdAt  DateTime  @default(now())

  @@index([resolvedAt])
  @@map("review_report")
}

// ---------------------------------------------------------------------------
// Rappels — trace de ce qui a déjà été envoyé.
//
// Une table plutôt qu'une colonne `reminderSentAt` : l'unicité (cours, type)
// laisse la base arbitrer la course entre deux passages de la tâche planifiée
// qui se chevauchent, exactement comme les contraintes d'exclusion sur les
// réservations. Un test applicatif « a-t-on déjà envoyé ? » suivi d'un envoi
// laisse une fenêtre où l'élève reçoit deux fois le même e-mail.
//
// Elle ouvre aussi la porte à d'autres échéances (H1, veille au soir) sans
// nouvelle migration.
// ---------------------------------------------------------------------------

enum ReminderKind {
  H24
}

model BookingReminder {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  kind   ReminderKind
  sentAt DateTime     @default(now())

  // Le cœur du dispositif : deux passages simultanés ne peuvent pas réclamer
  // le même rappel.
  @@unique([bookingId, kind])
  @@map("booking_reminder")
}
